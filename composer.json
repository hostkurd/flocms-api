{
  "name": "hostkurd/flocms-api",
  "description": "Optional modern API runtime for Flo Framework: explicit routing, middleware, JSON errors, CORS, authentication contracts, and rate limiting.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "HostKurd"
    }
  ],
  "require": {
    "php": "^8.1",
    "hostkurd/flocms-core": "^2.8",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "hostkurd/flocms-cli": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "hostkurd/flocms-uploader": "1.2.0"
  },
  "suggest": {
    "hostkurd/flocms-uploader": "Uploads through the API (Uploads\\HandlesUploads), 1.2+ for chunked uploads.",
    "ext-apcu": "Faster rate limiting with ApcuRateLimiter."
  },
  "autoload": {
    "psr-4": {
      "FloCMS\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FloCMS\\Api\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/flo-api"
  ],
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "1.3-dev"
    },
    "flocms": {
      "commands": [
        "FloCMS\\Api\\Console\\Commands\\ListCommand",
        "FloCMS\\Api\\Console\\Commands\\InstallSchemaCommand",
        "FloCMS\\Api\\Console\\Commands\\KeyCreateCommand",
        "FloCMS\\Api\\Console\\Commands\\KeyListCommand",
        "FloCMS\\Api\\Console\\Commands\\KeyRevokeCommand",
        "FloCMS\\Api\\Console\\Commands\\TokenCreateCommand",
        "FloCMS\\Api\\Console\\Commands\\TokenListCommand",
        "FloCMS\\Api\\Console\\Commands\\TokenRevokeCommand",
        "FloCMS\\Api\\Console\\Commands\\GcCommand",
        "FloCMS\\Api\\Console\\Commands\\RoutesCommand",
        "FloCMS\\Api\\Console\\Commands\\DocsCommand",
        "FloCMS\\Api\\Console\\Commands\\InstallCommand"
      ],
      "migrations": [
        "database/migrations"
      ],
      "route-providers": [
        "FloCMS\\Api\\Console\\Commands\\ApiRoutes"
      ]
    }
  }
}
